# Secrets & credentials
# `.env.*` con excepcion explicita: el patron literal `.env` no cubria variantes
# como `.env.etl` (el nombre que usa el deploy del visor), `.env.prod` o
# `.env.232`, y cualquiera de esas habria entrado al repo sin avisar.
.env
.env.*
!.env.example
*.pem
*.key
*.ppk
*.p12
*.pfx
id_rsa*
id_ed25519*
*credentials*.json
*service-account*.json

# Logs & local data
*.log
audit-ledger.jsonl
.alert-state.json

# Real ETL catalog (internal job/table/path names) — keep only the example
config/alert-rules.yml
*.bak

# ETL de empresas (empresas/**): SOLO se versionan los *.example.
# Los configs reales llevan credenciales del ERP y de GCP y viven en cada box.
empresas/**/config/pipeline_config.yaml
empresas/**/config/rotacion.env
empresas/**/config/rotacion.ps1
empresas/**/.venv/
empresas/**/logs/
# Volcados de esquema del ERP: pesados y con detalle interno del cliente.
empresas/**/schema_*.sql
empresas/**/esquema.sql

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
build/
dist/
*.egg-info/

# Editor / OS
.DS_Store
.idea/
.vscode/
CLAUDE.local.md
